# Variables del compose conjunto (copiar como .env junto a compose.yml). Todas son opcionales.

# Red donde vive el Postgres existente y el nombre de host con el que se le ve en ella.
SHARED_NETWORK=servicios_compartidos     # en local con el Postgres de compose.local-db.yml: eco-kb_default
DB_HOST=db

# Contraseñas de los usuarios creados con ECO-KB/scripts/bootstrap-db.sh
ECOKB_ADMIN_PASSWORD=
ECOKB_SUPPORT_PASSWORD=
ECOKB_SALES_PASSWORD=

# Puertos publicados
WEB_PORT=8080
API_PORT=8000

# Archivo con GOOGLE_API_KEY y modelos de la API (ver ECO-KB/.env.server.example)
API_ENV_FILE=./ECO-KB/.env

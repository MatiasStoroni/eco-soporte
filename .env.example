# Variables del compose conjunto (copiar como .env junto a compose.yml). Todas son opcionales.

# Contraseñas de la base propia "eco-db". Solo se aplican al crear el volumen por primera vez:
# si las cambias después, hay que cambiarlas también dentro de la base (o `docker compose down -v` y re-ingestar).
ECOKB_ADMIN_PASSWORD=eco
ECOKB_SUPPORT_PASSWORD=
ECOKB_SALES_PASSWORD=

# Puertos publicados
WEB_PORT=8090
API_PORT=8000

# Archivo con GOOGLE_API_KEY y modelos de la API (ver ECO-KB/.env.server.example)
API_ENV_FILE=./ECO-KB/.env

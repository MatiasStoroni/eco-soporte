# --- LLM (formato proveedor:modelo, ver init_chat_model) ---
GOOGLE_API_KEY=
LLM_GENERATOR_MODEL=google_genai:gemini-3.5-flash
LLM_GRADER_MODEL=google_genai:gemini-3.5-flash-lite
# Nivel de razonamiento (minimal|low|medium|high; vacío = el del modelo). low = menor latencia sin perder calidad.
LLM_GENERATOR_THINKING=low
LLM_GRADER_THINKING=

# --- Embeddings ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Base de datos (un pool/rol por flujo) ---
DB_PORT=5433
DATABASE_URL_ADMIN=postgresql://ecokb:ecokb@127.0.0.1:5433/ecokb
DATABASE_URL_SUPPORT_RO=postgresql://rag_support_ro:support_ro_dev@127.0.0.1:5433/ecokb
DATABASE_URL_SALES_RO=postgresql://rag_sales_ro:sales_ro_dev@127.0.0.1:5433/ecokb

# --- Umbrales ---
MIN_VECTOR_SCORE=0.45
TOP_K=8
MAX_RET=2
MAX_GEN=3

# --- Google Drive (fuente de la KB en producción) ---
DRIVE_ROOT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_SECRET_PATH=secrets/google_client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=secrets/google_token.json
DRIVE_SYNC_INTERVAL_MINUTES=15

# Copiar como .env en el SERVIDOR y rellenar. Nunca commitear.
GOOGLE_API_KEY=
LLM_GENERATOR_MODEL=google_genai:gemini-3.5-flash
LLM_GRADER_MODEL=google_genai:gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Host = contenedor de Postgres en la red servicios_compartidos ("postgres-server").
# Usuarios y contraseñas = los de scripts/bootstrap-db.sh
DATABASE_URL_ADMIN=postgresql://eco:eco@postgres-server:5432/ecokb
DATABASE_URL_SUPPORT_RO=postgresql://rag_support_ro:CAMBIAR_SOPORTE@postgres-server:5432/ecokb
DATABASE_URL_SALES_RO=postgresql://rag_sales_ro:CAMBIAR_VENTAS@postgres-server:5432/ecokb

MIN_VECTOR_SCORE=0.45
TOP_K=8
MAX_RET=2
MAX_GEN=3

# Panel de administración (/admin.html en la vista). Vacío = desactivado. Usar un valor largo y aleatorio:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# Google Drive (si usas el servicio sync)
DRIVE_ROOT_FOLDER_ID=
GOOGLE_OAUTH_CLIENT_SECRET_PATH=secrets/google_client_secret.json
GOOGLE_OAUTH_TOKEN_PATH=secrets/google_token.json
DRIVE_SYNC_INTERVAL_MINUTES=15

# Opcional
API_PORT=8000
